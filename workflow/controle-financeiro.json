    {
      "parameters": {
        "jsCode": "const rows = $input.all().filter(i => Object.keys(i.json).length > 0);\nlet receita = 0;\nlet despesa = 0;\n\nfor (const i of rows) {\n  const valor = Number(i.json.valor) || 0;\n  const tipo = String(i.json.Tipo || '').toLowerCase();\n  if (tipo === 'receita') {\n    receita += valor;\n  } else if (tipo === 'despesa') {\n    despesa += valor;\n  }\n}\nconst saldo = receita - despesa;\nreturn [{ json: { receita, despesa, saldo, quantidade: rows.length } }];"
      },
